# Optional. When set, the ambient copy (the intro line, the drifting whispers
# in the catching game, and the game hint) is generated with OpenAI and cached
# for a few hours, so repeat visits read a little differently.
#
# Without it, the site falls back to a hand-written pool — everything still
# works, it just varies less. The key is only ever read on the server.
OPENAI_API_KEY=

# Optional. Backs the "Stars" tab (the jar of folded-paper notes) with Supabase
# so stars persist across devices and browser resets. Without these, the tab
# still renders — it just shows an "out of reach" state and can't save.
#
# Both are read only on the server (route handlers under app/api/stars); the
# key is a Supabase *publishable* key and Row Level Security on the `stars`
# table scopes what it can do. Never prefix these with NEXT_PUBLIC.
# Schema: supabase/migrations/0001_stars.sql
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
